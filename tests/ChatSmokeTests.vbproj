<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>ChatSmokeTests</AssemblyName>
    <RootNamespace>ChatSmokeTests</RootNamespace>
    <StartupObject>ChatSmokeTests.Program</StartupObject>
    <OutputPath>bin\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Markdig">
      <HintPath>..\packages\Markdig.1.4.1\lib\net462\Markdig.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\VBACodeWriter\VBACodeWriter.vbproj">
      <Project>{BCE96CDA-D07C-45D8-9CC3-51A06CAB1F81}</Project>
      <Name>VBACodeWriter</Name>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Import Include="System" />
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System.Windows.Forms" />
    <Compile Include="ChatSmokeTests.vb" />
    <Compile Include="..\VBACodeWriter\OpenAiChatClient.vb"><Link>OpenAiChatClient.vb</Link></Compile>
    <Compile Include="..\VBACodeWriter\ChatMarkdown.vb"><Link>ChatMarkdown.vb</Link></Compile>
    <Compile Include="..\VBACodeWriter\VbeChatSidebar.vb"><Link>VbeChatSidebar.vb</Link></Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
</Project>