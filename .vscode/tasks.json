{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build and deploy VBACodeWriter locally",
			"type": "shell",
			"command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
			"args": [
				"${workspaceFolder}/VBACodeWriter/VBACodeWriter.vbproj",
				"/t:Rebuild",
				"/p:Configuration=Debug",
				"/p:Platform=AnyCPU",
				"/p:RegisterForComInterop=false",
				"/p:RunCodeAnalysis=false",
				"/v:minimal",
				"/nologo"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}